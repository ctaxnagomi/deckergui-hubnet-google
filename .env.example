# Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: enables the Firestore-backed store instead of the in-memory fallback
GOOGLE_CLOUD_PROJECT=

# Engine + server config
GEMINI_MODEL=gemini-2.5-flash
PORT=8080

# Phase-1 transport policy (i2i LAN-only)
DGUI_HUBNET_I2I_LAN_ONLY=1
