{
  "name": "dgui-hubnet-google",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DGUI HUB NET — Google Cloud execution layer (Gemini + Firestore). Cloud Run ready.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "bash demo/hubnet-google.sh"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "@google-cloud/firestore": "^9.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2"
  }
}
