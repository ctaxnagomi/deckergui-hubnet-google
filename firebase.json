{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/health", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/connect", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/approve", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/assign", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/advance", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/validate", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/execute", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/list", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "/show/**", "run": { "serviceId": "dgui-hubnet-google", "region": "asia-southeast1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
